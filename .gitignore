# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
.turbo

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files — use Doppler, not .env files
.env
.env.*
.dev.vars

# Cloudflare
.wrangler/

# Drizzle local SQLite (created by drizzle-kit push)
**/drizzle/*.sqlite

# Build artifacts
*.bak
*.tsbuildinfo

# Test artifacts
coverage/
output/
playwright-report/
test-results/
.playwright-mcp/

# ESLint plugin build artifacts (rebuilt via `pnpm run build:plugins`)
packages/tooling/eslint-config/*/dist/
packages/contracts/narduk-platform/dist/
packages/modules/narduk-mapkit-nuxt/dist/
# narduk-mapkit deliberately COMMITS its dist/ (git-dependency consumers
# install it without a build step); only the Nuxt adapter's build output
# above is ignored.
.pack/
# ESLint caches
.eslint-results.json

# Secrets & credential artifacts (use Doppler, never commit these)
*-secrets.json
*.jsonl
lint-results.txt
.npmrc.auth

# Python cache (uipro skill)
__pycache__/
*.pyc

# Legacy local skills scratch dir
.skills
.agents/skills/
.agents/.narduk-skills.generated.json
.codegraph/
.cursor/rules/codegraph.mdc

# Logging package build and language environments
packages/modules/narduk-logging/dist/
packages/modules/narduk-logging/python/dist/

# Postgres and timeseries packages build to dist/ at prepack; it is never committed
packages/modules/narduk-postgres/dist/
packages/modules/narduk-timeseries/dist/
packages/modules/narduk-logging/python/.venv/
packages/modules/narduk-logging/python/.pytest_cache/
packages/modules/narduk-logging/python/.ruff_cache/
.build/
.swiftpm/

# Local audit snapshots
artifacts/
.ci-evidence/

# Per-lane evidence transcripts (packed-consumer fixtures, gate tails)
.lane-evidence/
