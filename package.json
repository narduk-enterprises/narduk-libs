{
  "name": "narduk-libs",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "postinstall": "pnpm --filter @narduk-enterprises/eslint-config run build",
    "build": "turbo run build --filter='./packages/*/*' --concurrency=4",
    "build:affected": "turbo run build --filter='./packages/*/*' --affected --concurrency=4",
    "typecheck": "turbo run typecheck --filter='./packages/*/*' --concurrency=4",
    "typecheck:affected": "turbo run typecheck --filter='./packages/*/*' --affected --concurrency=4",
    "lint": "turbo run lint --filter='./packages/*/*' --concurrency=4 && pnpm run format:check",
    "lint:affected": "turbo run lint --filter='./packages/*/*' --affected --concurrency=4 && pnpm run format:check",
    "format": "prettier --write --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\"",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\"",
    "test": "pnpm --workspace-concurrency=2 -r --filter './packages/*/*' --if-present test:unit",
    "quality": "pnpm run versions:check && pnpm run release-plan:check && pnpm run quality:artifacts",
    "quality:artifacts": "pnpm run format:check && pnpm run surface:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "surface:check": "node scripts/check-component-surface.mjs",
    "scripts:test": "node --test scripts/*.test.mjs",
    "changeset": "changeset",
    "pack:check": "node scripts/release-packages.mjs --dry-run",
    "preflight": "node scripts/preflight.mjs",
    "release:dry-run": "node scripts/release-packages.mjs --dry-run",
    "release:consumer-smoke": "node scripts/release-packages.mjs --dry-run --consumer-smoke",
    "release:version": "pnpm run release-plan:check && changeset version && pnpm run versions:sync",
    "release:publish": "node scripts/publish-verified-packages.mjs",
    "release:synthesize-drift": "node scripts/synthesize-manifest-drift.mjs",
    "release:verify-published": "node scripts/verify-published-packages.mjs",
    "release-plan:check": "node scripts/check-generator-release-plan.mjs",
    "versions:check": "node scripts/sync-generator-package-versions.mjs --check",
    "versions:sync": "node scripts/sync-generator-package-versions.mjs",
    "ci:plan": "node scripts/ci-packages.mjs --plan",
    "ci:affected": "node scripts/ci-packages.mjs",
    "ci:full": "node scripts/ci-packages.mjs --all",
    "ci:batch": "node scripts/ci-packages.mjs --batch",
    "design-system:build": "pnpm --filter @narduk-enterprises/design-system-build build",
    "explorer:dev": "pnpm --filter @narduk-enterprises/libs-explorer dev",
    "explorer:build": "pnpm --filter @narduk-enterprises/libs-explorer build",
    "explorer:test": "pnpm --filter @narduk-enterprises/libs-explorer test:unit && pnpm --filter @narduk-enterprises/libs-explorer test:e2e"
  },
  "pnpm": {
    "overrides": {
      "prettier": "3.9.4",
      "drizzle-orm": "0.45.2",
      "esbuild": ">=0.25.0",
      "serialize-javascript": ">=7.0.5",
      "@cloudflare/unenv-preset": "2.12.1",
      "glob": "13.0.6",
      "@cloudflare/workers-types": "4.20260511.1",
      "@typescript-eslint/utils": "^8.70.0",
      "@nuxt/eslint": "^1.15.2",
      "eslint-plugin-unicorn": "^72.0.0",
      "svgo": "^4.1.0",
      "tar": "^7.5.21",
      "miniflare>sharp": "^0.35.4",
      "miniflare>undici": "^7.29.1",
      "flatted": "3.4.2",
      "node-forge": "1.4.0",
      "defu": "6.1.7",
      "@eslint/config-inspector>h3": "1.15.11",
      "@stylistic/eslint-plugin>picomatch": "4.0.4",
      "vite": "7.3.6",
      "@nuxt/vite-builder@4.5.2>vite": "8.3.0",
      "vite-node@6>vite": "8.3.0",
      "vite>picomatch": "4.0.4",
      "micromatch>picomatch": "2.3.2",
      "listhen>h3": "1.15.11",
      "@nuxt/image>h3": "1.15.11",
      "@nuxt/fonts>h3": "1.15.11",
      "nuxt-auth-utils>h3": "1.15.11",
      "@nuxt/test-utils>h3": "1.15.11",
      "@nuxt/test-utils>h3-next": "npm:h3@2.0.1-rc.22",
      "anymatch>picomatch": "2.3.2",
      "tinyglobby>picomatch": "4.0.4",
      "unplugin>picomatch": "4.0.4",
      "unplugin-utils>picomatch": "4.0.4",
      "unimport>picomatch": "4.0.4",
      "vitest>picomatch": "4.0.4",
      "@vue/language-core>picomatch": "4.0.4",
      "vite>yaml": "2.8.4",
      "yaml": "2.8.4",
      "minimatch@3>brace-expansion": "^1.1.18",
      "minimatch@5>brace-expansion": "^2.1.4",
      "minimatch@9>brace-expansion": "^2.1.4",
      "minimatch@10>brace-expansion": "^5.0.9",
      "vitest": "4.1.11",
      "vue-router": "^5.3.1",
      "@types/node@^22": "22.19.19"
    },
    "peerDependencyRules": {
      "allowAny": [
        "eslint",
        "citty",
        "@cloudflare/workers-types",
        "@simplewebauthn/browser",
        "@simplewebauthn/server"
      ],
      "ignoreMissing": [
        "@tiptap/y-tiptap",
        "@tiptap/extensions",
        "yjs",
        "embla-carousel"
      ]
    },
    "allowedDeprecatedVersions": {
      "@esbuild-kit/core-utils": "*",
      "@esbuild-kit/esm-loader": "*",
      "@types/parse-path": "*",
      "prebuild-install": "*"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ]
  },
  "volta": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@changesets/get-release-plan": "^4.0.16",
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.19.19",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "turbo": "^2.9.14",
    "typescript": "~6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.21.0"
  }
}
