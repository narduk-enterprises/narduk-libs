# Prettier ignore — keep in sync with .gitignore for build outputs.
# .gitignore is also consumed by Prettier (--ignore-path defaults), but
# Prettier looks at .prettierignore first, so we restate the high-impact
# entries here for clarity and to add formatter-only ignores below.

# ── Dependencies ────────────────────────────────────────────────────────
node_modules

# ── Build outputs / generated trees ─────────────────────────────────────
.nuxt
.output
.nitro
.turbo
.cache
.wrangler
.fleet
dist
build
coverage
playwright-report
test-results
output/

# ── Local data / fixtures (per-machine) ─────────────────────────────────
.data
apps/web/.data
.snapshots

# ── Local env files ─────────────────────────────────────────────────────
.env
.env.*
.dev.vars

# ── Lockfiles (pnpm owns formatting) ────────────────────────────────────
# pnpm v9+ lockfile uses YAML keys Prettier cannot parse
pnpm-lock.yaml
package-lock.json
yarn.lock

# ── Cloudflare Wrangler ─────────────────────────────────────────────────
# Frequently touched by provisioning and the wrangler CLI; formatting churn
# does not buy much and breaks fleet quality checks.
**/wrangler.json
**/wrangler.jsonc

# ── Drizzle SQL migrations (committed by the layer; do not reformat) ───
**/drizzle/**/*.sql
**/drizzle/meta/**

# ── gh-aw compiled workflow locks (regenerated by `gh aw compile`) ─────
# Prettier's YAML rules rewrite single-quoted scalars that gh-aw emits,
# which drifts the committed lock away from what `gh aw compile` produces.
# Treat these files as vendored build artifacts.
tools/starter-templates/agentic-workflows/*.lock.yml
.github/workflows/*.lock.yml
starters/default/.github/workflows/*.lock.yml
packages/narduk-cli/src/sync/assets/.github/workflows/*.lock.yml

# ── Generated docs / OpenAPI (regenerated, not authored) ────────────────
**/.openapi/**
**/openapi.json

# ── Accidental ESLint output dumps (not valid JSON for Prettier) ───────
**/eslint-results.json
**/lint-results.json

# ── Skills directories — external/vendored code, not ours to format ────
.agents/skills/
.agents/.narduk-skills.generated.json
**/.agents/skills/
**/.agents/.narduk-skills.generated.json
.agent/skills/
.github/skills/

# ── Vendored dependencies ───────────────────────────────────────────────
vendor/

# ── Worktrees and archives ──────────────────────────────────────────────
.worktrees/
.codex-worktrees/
**/.archived/**

# ── Snapshots and dump files ────────────────────────────────────────────
*.dump
*.sql.gz
*.tar.gz

# ── Generated changelogs (written by changesets, not hand-authored) ────
**/CHANGELOG.md
