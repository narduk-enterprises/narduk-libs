{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  // See tsconfig.json: `server/handlers` builds separately via
  // tsconfig.build.handlers.json to avoid the DOM/workers-types global clash.
  "exclude": ["tests/**", "src/server/handlers/**"]
}
