{
  "product": {
    "repository": "narduk-enterprises/operator-portal"
  },
  "worker": {
    "wranglerConfig": "apps/web/wrangler.json"
  },
  "deployment": {
    "standard": "narduk-v1",
    "builder": "workers-builds",
    "accountId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "productionBranch": "main",
    "productionDeployCommand": "narduk-app deploy versions-upload",
    "nonProductionDeployCommand": "narduk-app deploy versions-upload",
    "nonProductionBranchBuilds": false,
    "promotion": {
      "mode": "auto-on-green",
      "gateCheck": "ci / Required",
      "credential": "cloudflare/prd/narduk-enterprises-operator-portal-promote"
    },
    "liveProof": {
      "buildVersionHeader": "x-build-version",
      "healthPath": "/api/health",
      "smokePath": "/",
      "attempts": 6,
      "intervalSeconds": 10
    },
    "rollback": {
      "mode": "auto",
      "alert": "resend"
    },
    "staging": {
      "enabled": false
    },
    "previewBindings": {
      "d1": [],
      "kv": [],
      "r2": []
    },
    "migrations": {
      "compatibility": "expand-contract",
      "credential": "cloudflare/prd/narduk-enterprises-operator-portal-migrate",
      "databases": [
        {
          "binding": "DB",
          "sources": "apps/web/migrations.sources.json"
        }
      ]
    },
    "databaseOwnership": [
      {
        "binding": "DB",
        "owner": "migrations"
      },
      {
        "binding": "READ_MODEL",
        "owner": "contract",
        "contract": "apps/web/read-model/contract.json",
        "verify": "pnpm run read-model:check"
      }
    ]
  }
}
