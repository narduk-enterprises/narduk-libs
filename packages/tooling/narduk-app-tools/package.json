{
  "name": "@narduk-enterprises/narduk-app-tools",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Focused app-local development, migration, deployment, and asset tools.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/tooling/narduk-app-tools"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "narduk-app": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "import": "./dist/migrations.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "tsconfig.json",
    "tsconfig.build.json",
    "vitest.config.ts"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,js,mjs,json,yaml,yml,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "lint": "eslint src tests --max-warnings 0",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test:unit": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "volta": {
    "node": "22.22.3"
  }
}
