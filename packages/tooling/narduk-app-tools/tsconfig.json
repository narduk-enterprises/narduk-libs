{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "../.."
  },
  "include": ["src/**/*.ts", "tests/**/*.test.ts"]
}
