{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": [
    "index.mjs",
    "stylelint-budget.mjs",
    "bin/**/*.mjs",
    "plugins/**/*.mjs",
    "tests/**/*.ts"
  ]
}
