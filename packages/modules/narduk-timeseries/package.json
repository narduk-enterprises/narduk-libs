{
  "name": "@narduk-enterprises/narduk-timeseries",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "A TelemetryHistoryStore boundary for Narduk products: a TimescaleDB + PostGIS adapter with bounded batched writes, rollup and track queries, tier-parameterized retention, and a read-only Influx adapter for dual-run parity.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/narduk-timeseries"
  },
  "homepage": "https://github.com/narduk-enterprises/narduk-libs/tree/main/packages/modules/narduk-timeseries#readme",
  "bugs": {
    "url": "https://github.com/narduk-enterprises/narduk-libs/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./timescale": {
      "types": "./dist/timescale/index.d.ts",
      "import": "./dist/timescale/index.js"
    },
    "./influx": {
      "types": "./dist/influx.d.ts",
      "import": "./dist/influx.js"
    },
    "./migrations/*": "./migrations/*"
  },
  "files": [
    "dist/",
    "migrations/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "deps:build": "pnpm --filter @narduk-enterprises/narduk-postgres run build",
    "prebuild": "node scripts/clean-dist.mjs && pnpm run deps:build",
    "build": "tsc --project tsconfig.build.json",
    "prepack": "pnpm run build",
    "pretypecheck": "pnpm run deps:build",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "prelint": "pnpm run deps:build",
    "lint": "narduk-lint src tests",
    "lint:strict": "eslint src tests --max-warnings 0",
    "pretest:unit": "pnpm run deps:build",
    "test:unit": "vitest run --coverage --config vitest.config.ts",
    "check:package": "pnpm run build && publint --strict && pnpm pack --dry-run",
    "quality": "pnpm run test:unit",
    "quality:strict": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run build",
    "format": "pnpm run prettier:fix",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,js,mjs,json,yaml,yml,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "prettier": "pnpm run format:check",
    "prettier:fix": "prettier --write --log-level warn \"**/*.{ts,mts,js,mjs,json,yaml,yml,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@narduk-enterprises/narduk-postgres": "workspace:*"
  },
  "devDependencies": {
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "volta": {
    "node": "24.21.0"
  }
}
