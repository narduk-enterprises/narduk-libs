{
  "name": "@narduk-enterprises/narduk-mapkit-nuxt",
  "version": "2.0.6",
  "description": "Nuxt component, composables, and token route for @narduk-enterprises/narduk-mapkit.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/narduk-mapkit-nuxt"
  },
  "homepage": "https://github.com/narduk-enterprises/narduk-libs/tree/main/packages/modules/narduk-mapkit-nuxt#readme",
  "bugs": {
    "url": "https://github.com/narduk-enterprises/narduk-libs/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "nuxt-module-build build",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "lint": "narduk-lint",
    "prebuild": "nuxt-module-build prepare",
    "prelint": "pnpm run dev:prepare",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "pretest:unit": "pnpm run dev:prepare",
    "pretypecheck": "pnpm run dev:prepare",
    "test": "vitest run",
    "test:build": "pnpm run dev:prepare && nuxt build playground",
    "test:cloudflare": "node script/check-cloudflare-build.mjs",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@narduk-enterprises/narduk-mapkit": "workspace:*",
    "@nuxt/kit": "^4.4.8",
    "h3": "^1.15.4"
  },
  "//devDependencies": "happy-dom, @vitejs/plugin-vue and @vue/test-utils are pinned to the exact versions already resolved in this workspace's lockfile. A caret range makes pnpm re-resolve the shared entry to the newest satisfying release and re-key or move it for every other package, which is exactly the silent dependency drift narduk-libs#124 warns folds against. Widen them in a deliberate workspace-wide bump, not here.",
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/server-renderer": "3.5.39",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.10.6",
    "nuxt": "^4.5.2",
    "publint": "^0.3.21",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.39",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "@nuxt/schema": ">=4.0.0",
    "nuxt": ">=4.0.0",
    "vue": ">=3.5.0"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20"
  }
}
