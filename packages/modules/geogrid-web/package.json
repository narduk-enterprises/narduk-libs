{
  "name": "@narduk-enterprises/geogrid-web",
  "version": "0.2.0",
  "type": "module",
  "description": "Web twin of GeoGridKit: gridded geo-data overlay render (WebGL2 + Canvas2D fallback).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narduk-enterprises/GeoGridWeb.git"
  },
  "homepage": "https://github.com/narduk-enterprises/GeoGridWeb#readme",
  "bugs": {
    "url": "https://github.com/narduk-enterprises/GeoGridWeb/issues"
  },
  "license": "MIT",
  "keywords": [
    "canvas",
    "geo",
    "grid",
    "map",
    "raster",
    "webgl",
    "webgl2"
  ],
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:exports": "node script/check_package_exports.mjs",
    "check:package": "node script/check_package_exports.mjs",
    "prepare": "tsc -p tsconfig.build.json",
    "quality": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package && pnpm exec publint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "publint": "^0.3.21",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "packageManager": "pnpm@10.33.4"
}
