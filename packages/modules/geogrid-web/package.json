{
  "name": "@narduk-enterprises/geogrid-web",
  "version": "0.5.5",
  "type": "module",
  "description": "Web twin of GeoGridKit: gridded geo-data overlay and Web-Mercator tile render (WebGL2 + CPU fallback).",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/geogrid-web"
  },
  "homepage": "https://github.com/narduk-enterprises/narduk-libs/tree/main/packages/modules/geogrid-web#readme",
  "bugs": {
    "url": "https://github.com/narduk-enterprises/narduk-libs/issues"
  },
  "license": "MIT",
  "keywords": [
    "canvas",
    "geo",
    "grid",
    "map",
    "mercator",
    "raster",
    "tiles",
    "webgl",
    "webgl2"
  ],
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./overlay": {
      "types": "./dist/overlay/index.d.ts",
      "import": "./dist/overlay/index.js"
    },
    "./tile": {
      "types": "./dist/tile/index.d.ts",
      "import": "./dist/tile/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:exports": "node script/check_package_exports.mjs",
    "check:package": "node script/check_package_exports.mjs && publint --strict && pnpm pack --dry-run",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,js,mjs,json,yaml,yml,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "lint": "narduk-lint",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "publint": "^0.3.21",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
