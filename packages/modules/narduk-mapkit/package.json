{
  "name": "@loganrenz/narduk-mapkit",
  "version": "0.3.0",
  "type": "module",
  "description": "Framework-agnostic Apple MapKit JS token, geometry, runtime, and playback helpers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loganrenz/narduk-mapkit.git"
  },
  "homepage": "https://github.com/loganrenz/narduk-mapkit#readme",
  "bugs": {
    "url": "https://github.com/loganrenz/narduk-mapkit/issues"
  },
  "license": "MIT",
  "keywords": [
    "apple-maps",
    "geojson",
    "mapkit",
    "mapkit-js",
    "maps",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dist/",
    "examples/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js"
    },
    "./playback": {
      "types": "./dist/playback.d.ts",
      "import": "./dist/playback.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./token": {
      "types": "./dist/token/index.d.ts",
      "import": "./dist/token/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:exports": "node script/check_package_exports.mjs",
    "check:package": "node script/check_package_exports.mjs && node script/check_package_install.mjs",
    "prepare": "tsc -p tsconfig.build.json",
    "publish:local": "node script/publish_local_package.mjs",
    "quality": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.33.4"
}
