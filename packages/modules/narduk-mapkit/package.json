{
  "name": "@narduk-geo/narduk-mapkit",
  "version": "1.3.0",
  "type": "module",
  "description": "Framework-agnostic Apple MapKit JS token, geometry, runtime, and playback helpers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narduk-geo/narduk-mapkit.git"
  },
  "homepage": "https://github.com/narduk-geo/narduk-mapkit#readme",
  "bugs": {
    "url": "https://github.com/narduk-geo/narduk-mapkit/issues"
  },
  "license": "MIT",
  "keywords": [
    "apple-maps",
    "geojson",
    "mapkit",
    "mapkit-js",
    "maps",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "dist/",
    "examples/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./apple-maps": {
      "types": "./dist/server/apple-maps.d.ts",
      "import": "./dist/server/apple-maps.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js"
    },
    "./playback": {
      "types": "./dist/playback.d.ts",
      "import": "./dist/playback.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./worker": {
      "types": "./dist/server/worker.d.ts",
      "import": "./dist/server/worker.js"
    },
    "./node": {
      "types": "./dist/server/node.d.ts",
      "import": "./dist/server/node.js"
    },
    "./token": {
      "types": "./dist/token/index.d.ts",
      "import": "./dist/token/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:exports": "node script/check_package_exports.mjs",
    "check:package": "node script/check_package_exports.mjs && node script/check_package_install.mjs",
    "check:publint": "publint",
    "prepare": "tsc -p tsconfig.build.json",
    "pack:artifacts": "node script/pack_packages.mjs",
    "release:verify-published": "node script/verify_published_packages.mjs",
    "quality": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:dist && pnpm run check:package && pnpm run check:publint && pnpm --filter @narduk-geo/narduk-mapkit-nuxt run quality",
    "check:dist": "node script/check_dist_clean.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "publint": "^0.3.21",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.4"
}
