{
  "name": "@narduk-enterprises/narduk-analytics",
  "version": "1.22.0",
  "private": false,
  "type": "module",
  "description": "PostHog, GA, Search Console, and IndexNow Nuxt module for Narduk Cloudflare apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/narduk-analytics"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./src/module.ts"
    },
    "./nuxt": {
      "import": "./src/module.ts"
    },
    "./app/*": {
      "import": "./app/*.ts"
    },
    "./app/components/*": {
      "import": "./app/components/*.vue"
    },
    "./app/composables/*": {
      "import": "./app/composables/*.ts"
    },
    "./app/plugins/*": {
      "import": "./app/plugins/*.ts"
    },
    "./app/types/*": {
      "types": "./app/types/*.d.ts"
    },
    "./app/types/adminPosthogDashboardTypes": {
      "types": "./app/types/adminPosthogDashboardTypes.ts",
      "import": "./app/types/adminPosthogDashboardTypes.ts",
      "default": "./app/types/adminPosthogDashboardTypes.ts"
    },
    "./app/utils/*": {
      "import": "./app/utils/*.ts"
    },
    "./server/*": {
      "import": "./server/*.ts"
    }
  },
  "files": [
    "app/",
    "server/",
    "src/",
    "eslint.config.mjs",
    "nuxt.config.ts",
    "tsconfig.json",
    "vitest.config.ts",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run nuxt:prepare",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "nuxt:prepare": "sh ../../../scripts/ensure-generated-files.sh .nuxt/tsconfig.json .nuxt/tsconfig.shared.json .nuxt/tsconfig.node.json .nuxt/nuxt.shared.d.ts .nuxt/nuxt.node.d.ts .nuxt/eslint.config.mjs -- nuxt prepare",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "pretypecheck": "pnpm run nuxt:prepare",
    "typecheck": "nuxt typecheck",
    "prelint": "pnpm run nuxt:prepare",
    "eslint:typegen": "eslint --print-config package.json >/dev/null 2>&1",
    "lint": "narduk-lint",
    "lint:strict": "eslint . --max-warnings 0",
    "test:unit": "vitest run --coverage --config vitest.config.ts",
    "quality": "pnpm run test:unit",
    "quality:strict": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run build",
    "format": "pnpm run prettier:fix",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "prettier": "pnpm run format:check",
    "prettier:fix": "prettier --write --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.7",
    "h3": "^1.15.11",
    "jose": "^6.2.3",
    "posthog-js": "^1.373.4",
    "web-vitals": "^5.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@narduk-enterprises/narduk-core": "workspace:*",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.8.0",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.5.2",
    "playwright": "1.61.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.90.1"
  },
  "peerDependencies": {
    "@narduk-enterprises/narduk-core": ">=2.6.3 <3.0.0",
    "nuxt": ">=4.0.0",
    "wrangler": ">=4.90.1"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "overrides": {
    "@cloudflare/unenv-preset": "2.12.1",
    "@nuxt/fonts": "0.14.0",
    "@takumi-rs/core": ">=0.70.1",
    "@takumi-rs/wasm": ">=0.70.1",
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "volta": {
    "node": "22.22.3"
  }
}
