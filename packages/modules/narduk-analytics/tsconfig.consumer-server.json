{
  // A deliberately *unaugmented* typecheck of the server sources this package
  // publishes, standing in for a consumer's Nitro type program.
  //
  // A consumer compiles our shipped `.ts` without the runtime-config
  // augmentation in `app/types/runtime-config.d.ts` taking effect, while this
  // package's own `nuxt typecheck` compiles the same files with it — which is
  // how narduk-libs#621 shipped green from our lane and red in every consumer.
  // This project reproduces the consumer's view: no `.nuxt/**`, no Nuxt
  // references, no augmentation. `tests/consumer-server-typecheck.test.ts`
  // runs it.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "#layer/*": ["../narduk-core/runtime/*"],
      "#narduk-analytics-server/*": ["./server/*"],
      "#narduk-core/postgres-runtime": ["../narduk-core/runtime/internal/postgres-runtime.stub.ts"],
      "#narduk-core/schema": ["../narduk-core/runtime/server/database/schema.ts"]
    }
  },
  "include": [
    "server/**/*.ts",
    "tests/fixtures/consumer-server-globals.d.ts",
    // Written and removed by `tests/consumer-server-typecheck.test.ts` while it
    // proves this project still rejects the narduk-libs#621 pattern. Absent the
    // rest of the time; tsc ignores an include entry that matches no file.
    "tests/fixtures/__consumer-probe.generated.ts"
  ]
}
