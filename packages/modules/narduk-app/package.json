{
  "name": "@narduk-enterprises/narduk-app",
  "version": "1.20.0",
  "private": false,
  "type": "module",
  "description": "Runtime app helpers for Narduk Cloudflare and Nuxt apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/narduk-app"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./server/http": {
      "import": "./src/server/http.ts"
    },
    "./server/errors": {
      "import": "./src/server/errors.ts"
    },
    "./server/request-body": {
      "import": "./src/server/request-body.ts"
    },
    "./client/api-error": {
      "import": "./src/client/api-error.ts"
    }
  },
  "files": [
    "src/",
    "README.md",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "scripts": {
    "build": "pnpm run typecheck",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src tests --max-warnings 0",
    "test:unit": "vitest run --coverage --config vitest.config.ts",
    "format": "pnpm run prettier:fix",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,js,mjs,json,yaml,yml,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "prettier": "pnpm run format:check",
    "prettier:fix": "prettier --write --log-level warn \"**/*.{ts,mts,js,mjs,json,yaml,yml,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "h3": "^1.15.11"
  },
  "devDependencies": {
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "volta": {
    "node": "22.22.3"
  }
}
