{
  "name": "@narduk-enterprises/narduk-ai",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "description": "Reusable AI contracts, xAI helpers, prompt resolution, and admin configuration for Narduk Nuxt apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/narduk-ai"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./src/module.ts"
    },
    "./nuxt": {
      "import": "./src/module.ts"
    },
    "./app/components/admin/AdminAiTab": {
      "import": "./app/components/admin/AdminAiTab.vue"
    },
    "./app/composables/useAdminAi": {
      "import": "./app/composables/useAdminAi.ts"
    },
    "./app/utils/xaiModels": {
      "import": "./app/utils/xaiModels.ts"
    },
    "./server/api/admin/ai/model.get": {
      "import": "./server/api/admin/ai/model.get.ts"
    },
    "./server/api/admin/ai/model.put": {
      "import": "./server/api/admin/ai/model.put.ts"
    },
    "./server/api/admin/system-prompts/index.get": {
      "import": "./server/api/admin/system-prompts/index.get.ts"
    },
    "./server/api/admin/system-prompts/index.put": {
      "import": "./server/api/admin/system-prompts/index.put.ts"
    },
    "./server/utils/aiContracts": {
      "import": "./server/utils/aiContracts.ts"
    },
    "./server/utils/aiPromptResolver": {
      "import": "./server/utils/aiPromptResolver.ts"
    },
    "./server/utils/aiXmlEscape": {
      "import": "./server/utils/aiXmlEscape.ts"
    },
    "./server/utils/chatModelConfig": {
      "import": "./server/utils/chatModelConfig.ts"
    },
    "./server/utils/xai": {
      "import": "./server/utils/xai.ts"
    },
    "./shared/types/runtime-config": {
      "types": "./shared/types/runtime-config.d.ts"
    },
    "./shared/utils/xaiRuntimeConfig": {
      "import": "./shared/utils/xaiRuntimeConfig.ts"
    }
  },
  "files": [
    "app/",
    "server/",
    "shared/",
    "src/",
    "eslint.config.mjs",
    "nuxt.config.ts",
    "tsconfig.json",
    "vitest.config.ts",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run nuxt:prepare",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "dev": "nuxt dev",
    "nuxt:prepare": "sh ../../../scripts/ensure-generated-files.sh .nuxt/tsconfig.json .nuxt/tsconfig.shared.json .nuxt/tsconfig.node.json .nuxt/nuxt.shared.d.ts .nuxt/nuxt.node.d.ts .nuxt/eslint.config.mjs -- nuxt prepare",
    "prepare": "nuxt prepare",
    "pretypecheck": "pnpm run nuxt:prepare",
    "prelint": "pnpm run nuxt:prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run --coverage --config vitest.config.ts",
    "format": "pnpm run prettier:fix",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "prettier": "pnpm run format:check",
    "prettier:fix": "prettier --write --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@narduk-enterprises/narduk-core": "workspace:*",
    "@narduk-enterprises/narduk-platform": "workspace:*",
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.7",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "zod": "^4.4.3"
  },
  "//devDependencies": "@vue/test-utils and happy-dom are pinned to the exact versions already resolved in this workspace's lockfile (the narduk-mapkit-nuxt package.json note). A caret range makes pnpm re-resolve the shared entry to the newest satisfying release and re-key or move it for every other package, which is exactly the silent dependency drift narduk-libs#124 warns folds against. Widen them in a deliberate workspace-wide bump, not here.",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@nuxt/test-utils": "^4.0.3",
    "@nuxt/ui": "4.8.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "happy-dom": "20.10.6",
    "miniflare": "4.20260701.0",
    "nuxt": "^4.5.2",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.39",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.90.1"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0",
    "vue": ">=3.5.0",
    "wrangler": ">=4.90.1"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    }
  },
  "volta": {
    "node": "22.22.3"
  }
}
