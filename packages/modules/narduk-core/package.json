{
  "name": "@narduk-enterprises/narduk-core",
  "version": "2.13.1",
  "private": false,
  "type": "module",
  "description": "Core Nuxt module, Worker runtime helpers, UI primitives, and database utilities for Narduk Cloudflare apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/modules/narduk-core"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./src/module-entry.ts"
    },
    "./nuxt": {
      "import": "./src/module-entry.ts"
    },
    "./app/components/app/*": {
      "import": "./runtime/app/components/app/*.vue"
    },
    "./app/components/shared/*": {
      "import": "./runtime/app/components/shared/*.vue"
    },
    "./app/composables/*": {
      "import": "./runtime/app/composables/*.ts"
    },
    "./app/error-page": {
      "types": "./runtime/app/error-page-component.d.ts",
      "import": "./runtime/app/error.vue"
    },
    "./app/stores/*": {
      "import": "./runtime/app/stores/*.ts"
    },
    "./app/types/*": {
      "types": "./runtime/app/types/*.d.ts"
    },
    "./app/types/api": {
      "types": "./runtime/app/types/api.ts"
    },
    "./app/utils/*": {
      "import": "./runtime/app/utils/*.ts"
    },
    "./drizzle/*": "./runtime/drizzle/*",
    "./eslint-app-config": {
      "import": "./eslint-app-config.mjs"
    },
    "./eslint-capability-packs": {
      "import": "./eslint-capability-packs.mjs"
    },
    "./eslint-nuxt-flat-fragments": {
      "import": "./eslint-nuxt-flat-fragments.mjs"
    },
    "./nuxt-module-package-config": {
      "types": "./src/nuxt-module-package-config.ts",
      "import": "./src/nuxt-module-package-config.ts"
    },
    "./internal/*": {
      "import": "./runtime/internal/*.ts"
    },
    "./server/middleware/canonicalRedirect": {
      "import": "./runtime/server/handlers/canonicalRedirect.ts"
    },
    "./server/*": {
      "import": "./runtime/server/*.ts"
    },
    "./shared/*": {
      "import": "./runtime/shared/*.ts"
    },
    "./shared/types/*": {
      "types": "./runtime/shared/types/*.d.ts"
    }
  },
  "files": [
    "runtime/",
    "src/",
    "eslint-app-config.mjs",
    "eslint-capability-packs.mjs",
    "eslint-nuxt-flat-fragments.mjs",
    "eslint.config.mjs",
    "nuxt.config.ts",
    "tsconfig.layer-tooling.json",
    "tsconfig.json",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run nuxt:prepare",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "dev": "nuxt dev",
    "nuxt:prepare": "sh ../../../scripts/ensure-generated-files.sh .nuxt/tsconfig.json .nuxt/tsconfig.shared.json .nuxt/tsconfig.node.json .nuxt/nuxt.shared.d.ts .nuxt/nuxt.node.d.ts .nuxt/eslint.config.mjs -- nuxt prepare",
    "prepare": "nuxt prepare",
    "pretypecheck": "pnpm run nuxt:prepare",
    "typecheck": "nuxt typecheck",
    "prelint": "pnpm run nuxt:prepare",
    "eslint:typegen": "eslint --print-config package.json >/dev/null 2>&1",
    "lint": "export NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=${NARDUK_LINT_MAX_OLD_SPACE_SIZE:-4096}\"; narduk-lint",
    "lint:strict": "eslint . --max-warnings 0",
    "test:unit": "vitest run --coverage",
    "quality": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit",
    "quality:strict": "pnpm run lint && pnpm run typecheck && pnpm run format:check && pnpm run build",
    "format": "pnpm run prettier:fix",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "prettier": "pnpm run format:check",
    "prettier:fix": "prettier --write --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.108",
    "@narduk-enterprises/narduk-logging": "workspace:*",
    "@narduk-enterprises/narduk-platform": "workspace:*",
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/kit": "^4.0.0",
    "@nuxt/ui": "4.11.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@pinia/nuxt": "^1.0.2",
    "@vue/devtools-api": "^8.1.5",
    "defu": "^6.1.7",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "jose": "^6.2.3",
    "nitropack": "^2.13.4",
    "nuxt-auth-utils": "^0.5.29",
    "pinia": "^4.0.3",
    "postcss": "^8.5.18",
    "postgres": "^3.4.9",
    "posthog-js": "^1.373.4",
    "tailwindcss": "^4.2.1",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "//devDependencies": "@vitejs/plugin-vue is pinned to the exact version already resolved in this workspace's lockfile (the narduk-mapkit-nuxt package.json note). A caret range makes pnpm re-resolve the shared entry to the newest satisfying release and re-key or move it for every other package (narduk-libs#124). Widen it in a deliberate workspace-wide bump, not here.",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@narduk-enterprises/eslint-config": "workspace:*",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.6",
    "@vue/test-utils": "^2.4.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "happy-dom": "^20.9.0",
    "hookable": "5.5.3",
    "miniflare": "4.20260701.0",
    "nitropack": "2.13.4",
    "nuxt": "^4.5.2",
    "nuxt-security": "^2.6.0",
    "playwright": "1.61.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.39",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.90.1"
  },
  "peerDependencies": {
    "@narduk-enterprises/eslint-config": ">=1.2.17 <3",
    "@nuxt/schema": ">=4.0.0",
    "nuxt": ">=4.0.0",
    "nuxt-security": "^2.6.0",
    "vue": ">=3.5.0",
    "vue-router": ">=5.2.0",
    "wrangler": ">=4.90.1"
  },
  "peerDependenciesMeta": {
    "@narduk-enterprises/eslint-config": {
      "optional": true
    },
    "wrangler": {
      "optional": true
    },
    "nuxt-security": {
      "optional": true
    }
  },
  "overrides": {
    "@cloudflare/unenv-preset": "2.12.1",
    "@nuxt/fonts": "0.14.0",
    "@takumi-rs/core": ">=0.70.1",
    "@takumi-rs/wasm": ">=0.70.1",
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "volta": {
    "node": "24.21.0"
  }
}
