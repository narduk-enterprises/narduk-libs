{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "#imports": ["./tests/stubs/nuxt-imports.ts"],
      "#layer": ["./runtime"],
      "#layer/*": ["./runtime/*"],
      "#narduk-core/schema": ["./runtime/server/database/schema.ts"],
      "#narduk-core/postgres-runtime": ["./runtime/internal/postgres-runtime.stub.ts"]
    }
  },
  "include": [
    "runtime/internal/**/*.ts",
    "runtime/app/components/shared/appConfirmModalDeprecation.ts",
    "runtime/app/error-page.ts",
    "runtime/app/session/useUserSessionStub.ts",
    "runtime/app/composables/useAppViewGate.ts",
    "runtime/app/composables/usePreferences.ts",
    "runtime/app/composables/useSsrNow.ts",
    "runtime/app/composables/useLiveProduct.ts",
    "runtime/app/composables/useFormat.ts",
    "runtime/app/composables/useInFlightTracker.ts",
    "runtime/app/composables/useIntervalRefresh.ts",
    "runtime/app/composables/useCurrentLocation.ts",
    "runtime/app/utils/ssrNowClock.ts",
    "runtime/app/utils/liveProduct.ts",
    "runtime/app/utils/preferencesState.ts",
    "runtime/app/utils/lightboxRails.ts",
    "runtime/app/utils/snapStripReadout.ts",
    "runtime/app/utils/footerExtensions.ts",
    "runtime/app/components/shared/appEmptyStateDeprecation.ts",
    "runtime/app/components/shared/appSettingsProfileDeprecation.ts",
    "runtime/server/middleware/00-canonical-host.ts",
    "runtime/server/middleware/01-head-as-get.ts",
    "runtime/server/middleware/securityHeaders.ts",
    "runtime/server/middleware/csrf.ts",
    "runtime/server/handlers/canonicalRedirect.ts",
    "runtime/server/handlers/cspReport.post.ts",
    "runtime/server/error-sanitizer.ts",
    "runtime/server/scheduled-jobs.ts",
    "runtime/server/wait-until.ts",
    "runtime/server/list-cursor.ts",
    "runtime/server/json-error-no-store.ts",
    "runtime/server/api/health.get.ts",
    "runtime/server/database/d1RoundTrips.ts",
    "runtime/server/database/pg-schema.ts",
    "runtime/server/database/schema.ts",
    "runtime/server/health/**/*.ts",
    "runtime/server/utils/atomic-batch.ts",
    "runtime/server/utils/auth.ts",
    "runtime/server/utils/database.ts",
    "runtime/server/utils/freshness-checks.ts",
    "runtime/server/utils/health-checks.ts",
    "runtime/server/utils/hyperdrive.ts",
    "runtime/server/utils/runtime-config.ts",
    "runtime/server/utils/approximateLocation.ts",
    "runtime/server/utils/authApiKeyD1.ts",
    "runtime/server/utils/authApiKeyText.ts",
    "runtime/server/utils/boundedBody.ts",
    "runtime/server/utils/cacheProfile.ts",
    "runtime/server/utils/client-ip.ts",
    "runtime/server/utils/cron.ts",
    "runtime/server/utils/shared-secret.ts",
    "runtime/server/utils/d1Cache.ts",
    "runtime/server/rate-limit/**/*.ts",
    "runtime/server/utils/publishedDataHandler.ts",
    "runtime/server/utils/rateLimitedHandler.ts",
    "runtime/server/utils/validatedHandler.ts",
    "runtime/server/utils/mutationValidation.ts",
    "runtime/server/utils/kv.ts",
    "runtime/server/utils/kvCache.ts",
    "runtime/server/utils/listQuery.ts",
    "runtime/server/utils/logger.ts",
    "runtime/server/utils/logSanitizer.ts",
    "runtime/server/utils/narduk-data.ts",
    "runtime/server/plugins/00-runtime-public.ts",
    "runtime/server/plugins/default-private-cache.ts",
    "runtime/server/plugins/error-cache.ts",
    "runtime/server/plugins/error-logger.ts",
    "runtime/server/plugins/nonce-csp-cache.ts",
    "runtime/server/plugins/preferences-cache.ts",
    "runtime/server/plugins/shared-cache-headers.ts",
    "runtime/server/utils/preferences.ts",
    "runtime/server/middleware/requestLogger.ts",
    "runtime/server/utils/runtime-env.ts",
    "runtime/server/utils/runtime-public.ts",
    "runtime/server/utils/runtime-url.ts",
    "runtime/server/utils/sessionGrant.ts",
    "runtime/server/utils/sse.ts",
    "runtime/server/utils/ssrfHostIpPolicy.ts",
    "runtime/server/utils/user-session.ts",
    "runtime/server/utils/worker-env.ts",
    "runtime/shared/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    // The D1 query harness, imported from source by the D1 driver tests.
    "../../tooling/narduk-testkit/src/d1.ts"
  ],
  "exclude": [
    // A standalone Nuxt app driven by `scripts/prove-nonce.mjs`, not layer
    // source. Its `defineNuxtConfig` comes from its own Nuxt context, which
    // this project never generates.
    "tests/fixtures/**",
    // Nuxt-context type proofs: `.nuxt/tsconfig.app.json` includes
    // `tests/nuxt/**`, where `#auth-utils` and the other Nuxt aliases resolve.
    "tests/nuxt/**",
    // Mount tests import SFCs. vue-tsc typechecks those components through
    // `.nuxt/tsconfig.app.json`; this project is TypeScript-only.
    "tests/app-image.test.ts",
    "tests/app-lightbox.test.ts",
    "tests/app-snap-strip.test.ts",
    "tests/layer-app-footer.test.ts"
  ]
}
