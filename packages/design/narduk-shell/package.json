{
  "name": "@narduk-enterprises/narduk-shell",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "Home of the app-tier Ne* component suite. A Nuxt module that registers every shared component with an explicit addComponent, wrapping Nuxt UI rather than reimplementing it.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/design/narduk-shell"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./module": {
      "types": "./src/module.ts",
      "import": "./src/module.ts"
    },
    "./format": {
      "types": "./src/format.ts",
      "import": "./src/format.ts"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "src",
    "theme.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "pnpm run typecheck",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "format": "prettier --write --log-level warn \"**/*.{ts,vue,json,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,vue,json,css,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@narduk-enterprises/narduk-platform": "workspace:*",
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.7"
  },
  "//devDependencies": "@vitejs/plugin-vue, @vue/test-utils, @vue/server-renderer and happy-dom are pinned to the exact versions already resolved in this workspace's lockfile (the narduk-mapkit-nuxt package.json note). A caret range makes pnpm re-resolve the shared entry to the newest satisfying release and re-key or move it for every other package (narduk-libs#124). Widen them in a deliberate workspace-wide bump, not here.",
  "devDependencies": {
    "@nuxt/schema": "^4.5.2",
    "@nuxt/ui": "4.8.1",
    "@types/node": "^22.19.19",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/server-renderer": "3.5.39",
    "@vue/test-utils": "2.4.11",
    "eslint": "^10.8.0",
    "happy-dom": "20.10.6",
    "nuxt": "^4.5.2",
    "prettier": "^3.8.3",
    "publint": "^0.3.21",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.39",
    "vue-router": "5.1.0",
    "vue-tsc": "^3.2.5"
  },
  "peerDependencies": {
    "@nuxt/ui": "4.8.1",
    "nuxt": ">=4.0.0",
    "vue": ">=3.5.0",
    "vue-router": "^4.5.0 || ^5.0.0"
  },
  "volta": {
    "node": "22.22.3"
  }
}
