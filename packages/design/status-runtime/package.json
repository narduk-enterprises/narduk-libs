{
  "name": "@narduk-enterprises/status-runtime",
  "version": "1.0.3",
  "private": false,
  "description": "Shared build-time configuration for the five status applications.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/design/status-runtime"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "main": "index.mjs",
  "types": "./index.d.mts",
  "files": [
    "index.mjs",
    "index.d.mts",
    "README.md"
  ],
  "exports": {
    ".": "./index.mjs"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "check:package": "publint --strict && pnpm pack --dry-run",
    "format:check": "prettier --check --log-level warn \"**/*.{mjs,mts,json,md}\" --ignore-path ../../../.gitignore --ignore-path ../../../.prettierignore",
    "lint": "narduk-lint",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "eslint": "^10.8.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "volta": {
    "node": "24.21.0"
  }
}
