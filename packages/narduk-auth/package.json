{
  "name": "@narduk-enterprises/narduk-auth",
  "version": "1.19.27",
  "private": false,
  "type": "module",
  "description": "Auth, user session, notification, and protected-route Nuxt module for Narduk Cloudflare apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/narduk-enterprises/narduk-libs.git",
    "directory": "packages/narduk-auth"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./src/module.ts"
    },
    "./nuxt": {
      "import": "./src/module.ts"
    },
    "./app/*": {
      "import": "./app/*.ts"
    },
    "./app/components/*": {
      "import": "./app/components/*.vue"
    },
    "./app/composables/*": {
      "import": "./app/composables/*.ts"
    },
    "./app/middleware/*": {
      "import": "./app/middleware/*.ts"
    },
    "./app/pages/*": {
      "import": "./app/pages/*.vue"
    },
    "./app/types/*": {
      "types": "./app/types/*.d.ts"
    },
    "./app/utils/*": {
      "import": "./app/utils/*.ts"
    },
    "./drizzle/*": "./drizzle/*",
    "./server/*": {
      "import": "./server/*.ts"
    },
    "./shared/*": {
      "import": "./shared/*.ts"
    },
    "./shared/types/*": {
      "types": "./shared/types/*.d.ts"
    }
  },
  "files": [
    "app/",
    "drizzle/",
    "server/",
    "shared/",
    "src/",
    "eslint.config.mjs",
    "nuxt.config.ts",
    "tsconfig.json",
    "vitest.config.ts",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm run nuxt:prepare",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "nuxt:prepare": "sh ../../scripts/ensure-generated-files.sh .nuxt/tsconfig.json .nuxt/tsconfig.shared.json .nuxt/tsconfig.node.json .nuxt/nuxt.shared.d.ts .nuxt/nuxt.node.d.ts .nuxt/eslint.config.mjs -- nuxt prepare",
    "preview": "nuxt preview",
    "prepare": "nuxt prepare",
    "pretypecheck": "pnpm run nuxt:prepare",
    "typecheck": "nuxt typecheck",
    "pretypecheck:postgres": "pnpm run nuxt:prepare",
    "typecheck:postgres": "NUXT_DATABASE_BACKEND=postgres nuxt typecheck",
    "prelint": "pnpm run nuxt:prepare",
    "eslint:typegen": "eslint --print-config package.json >/dev/null 2>&1",
    "lint": "eslint . --max-warnings 0 && pnpm run lint:server-boundaries && pnpm run lint:app-boundaries",
    "lint:app-boundaries": "eslint app --config ../../eslint.config.mjs --quiet --rule 'no-undef:error' --global '$fetch' --global clearInterval --global computed --global defineAppConfig --global defineNuxtRouteMiddleware --global definePageMeta --global document --global formatBuildTimeLocal --global navigateTo --global onMounted --global onUnmounted --global reactive --global ref --global setInterval --global shallowRef --global useAppConfig --global useAppFetch --global useAsyncData --global useAuth --global useAuthRuntimePublic --global useFetch --global useNuxtApp --global useRoute --global useRouter --global useRuntimeConfig --global useSeoMeta --global useState --global useToast --global useUserSession --global watch --global watchEffect --global window",
    "lint:server-boundaries": "eslint server --config ../../eslint.config.mjs --rule 'no-undef:error' --global atob --global crypto --global process --global setTimeout --max-warnings 0",
    "lint:strict": "eslint . --max-warnings 0",
    "test:unit": "vitest run --coverage --config vitest.config.ts",
    "quality": "pnpm run test:unit",
    "quality:strict": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:postgres && pnpm run format:check && pnpm run build",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "format": "pnpm run prettier:fix",
    "format:check": "prettier --check --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore",
    "prettier": "pnpm run format:check",
    "prettier:fix": "prettier --write --log-level warn \"**/*.{ts,mts,vue,js,mjs,json,yaml,yml,css,md}\" --ignore-path ../../.gitignore --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@narduk-enterprises/narduk-app": "workspace:*",
    "@narduk-enterprises/narduk-core": "workspace:*",
    "@nuxt/kit": "^4.0.0",
    "@supabase/auth-js": "^2.105.4",
    "@supabase/supabase-js": "^2.105.4",
    "defu": "^6.1.7",
    "drizzle-orm": "^0.45.2",
    "nuxt-auth-utils": "^0.5.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@narduk-enterprises/eslint-config": "1.2.17",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.19.19",
    "@vitest/coverage-v8": "4.1.6",
    "@vue/test-utils": "^2.4.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "h3": "^1.15.11",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.4.2",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.5",
    "wrangler": "^4.90.1"
  },
  "peerDependencies": {
    "nuxt": ">=3.16.0",
    "wrangler": ">=4.90.1"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "overrides": {
    "@cloudflare/unenv-preset": "2.12.1",
    "@nuxt/fonts": "0.14.0",
    "@takumi-rs/core": ">=0.70.1",
    "@takumi-rs/wasm": ">=0.70.1",
    "vite": "npm:rolldown-vite@7.3.1"
  },
  "volta": {
    "node": "22.22.3"
  }
}
