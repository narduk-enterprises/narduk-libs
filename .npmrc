@narduk-enterprises:registry=https://npm.pkg.github.com
auto-install-peers=false

# Heap ceiling for every pnpm-run script, in the repo instead of in CI job env.
#
# The hand-rolled CI matrix used to set a PER-PACKAGE NODE_OPTIONS
# (--max-old-space-size between 1024 and 2560) as job `env:`. The shared gate
# this repo now calls (narduk-enterprises/workflows node-library.yml@v1,
# company-hq#278) has no env input, so that tuning had to move somewhere real
# -- and workflow env was always the wrong home anyway, because it meant CI and
# a developer's local `pnpm run build` ran under different limits.
#
# 3072 is >= EVERY value the old workflow used (1024, 1536, 2304, 2560 in the
# matrix; 3072 in packed-consumer-smoke and release.yml), so no script gets a
# smaller heap than it had before this change and nothing can newly OOM.
# Verified locally that pnpm applies this to script NODE_OPTIONS and that it
# takes precedence over an ambient value -- which is why it must not be set
# BELOW 3072, or it would silently shrink the two jobs that ask for 3072.
#
# The per-package differentiation is deliberately not reproduced: those numbers
# were a budget for `max-parallel: 4` on one 20 GiB host, not per-package
# requirements. A ceiling does not cause consumption, so a uniform ceiling does
# not raise actual memory use; the concurrency bound is now the linux-ci pool's
# 6 listeners. If host pressure ever appears, the fix is a concurrency limit,
# not a smaller heap.
node-options=--max-old-space-size=3072
