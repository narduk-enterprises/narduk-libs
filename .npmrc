@narduk-enterprises:registry=https://npm.pkg.github.com
auto-install-peers=false

# Default heap ceiling for package builds, including the shared CI callable.
# pnpm applies this to lifecycle NODE_OPTIONS even when the caller supplied a
# different NODE_OPTIONS. Resource-constrained jobs must also override
# npm_config_node_options; the packed smoke uses 2048 on the 4 GiB browser pool.
# This ceiling only bounds V8 old space, not native memory or sibling processes.
node-options=--max-old-space-size=3072
